# ── Mode démo ─────────────────────────────────────────────
# Sans NEXT_PUBLIC_SUPABASE_URL, l'app tourne en démo (données dans le navigateur).
# NEXT_PUBLIC_DEMO_MODE=true   # force la démo même avec Supabase configuré

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Les prix (Mensuel, Carnet 12 mois, occasion +30 %, surclassements, extras, Pro) sont créés par
#   npm run stripe:setup
# et retrouvés par lookup_key : aucun identifiant de prix à recopier ici.

# ── Coursiers ─────────────────────────────────────────────
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
STUART_CLIENT_ID=
STUART_CLIENT_SECRET=
STUART_ENV=sandbox
COURIER_WEBHOOK_TOKEN=change-me
MONCLEUR_SUPPORT_PHONE=+33100000000

# ── Cron (Vercel envoie Authorization: Bearer $CRON_SECRET) ─
CRON_SECRET=change-me

# ── E-mails (rappel J-3, paiement refusé) ─────────────────
RESEND_API_KEY=
MONCLEUR_FROM_EMAIL=Moncleur <bonjour@moncleur.fr>

# Garantie de livraison
# E-mail de l'équipe qui reçoit les alertes (aucun atelier disponible, reprise en retard)
MONCLEUR_OPS_EMAIL=ops@moncleur.fr
# SMS aux ateliers (facultatif ; sans ces clés, les SMS sont journalisés)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+33XXXXXXXXX
